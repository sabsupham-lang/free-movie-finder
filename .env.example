# Copy to .env.local and fill in. Never commit .env.local.
# Every variable is optional. With none set, the app runs in demo mode
# using the bundled public-domain catalog (data/public-domain.json).

# TMDB API Read Access Token (the long "v4 auth" token, not the short v3 key).
# Unlocks the full catalog: popular, trending, cast, trailers and regional
# streaming availability (JustWatch data via TMDB).
# Get one free at https://www.themoviedb.org/settings/api
# Server-side only. It is never sent to the browser.
TMDB_READ_TOKEN=

# Country used for streaming availability until a visitor picks their own.
# Two-letter ISO 3166-1 code.
DEFAULT_REGION=US

# Shared secret for POST /api/revalidate (clears cached TMDB responses).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Public URL of the deployed site, used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only used by scripts/refresh-public-domain.mjs. Wikidata asks bots to
# include a contact (URL or email) in their User-Agent.
CATALOG_CONTACT=

# Site owner details shown on the Privacy and Terms pages. Until all of them
# are set, those pages show [PLACEHOLDERS] and a "Draft" notice.
# Example values: SITE_HOSTING_PROVIDER=Vercel Inc.
#                 SITE_GOVERNING_LAW=The laws of the State of New York, USA
#                 SITE_LEGAL_EFFECTIVE_DATE=2026-11-01   (YYYY-MM-DD)
SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
SITE_HOSTING_PROVIDER=
SITE_GOVERNING_LAW=
SITE_LEGAL_EFFECTIVE_DATE=
